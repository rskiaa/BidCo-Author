          incoming().id == existing().id &&
          incoming().orgId == existing().orgId &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time && (
            isAdmin() ||
            incoming().diff(existing()).affectedKeys().hasOnly([
              'overallStatus', 'summary', 'financialAssessment', 'experienceAssessment',
              'certificationAssessment', 'comparisons', 'missingDocuments',
              'complianceGaps', 'disqualificationRisks', 'updatedAt'
            ])
