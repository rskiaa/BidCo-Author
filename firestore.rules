          allow create: if isValidId(orgId) && isValidId(documentId) && isValidId(chunkId) &&
            isOrgMember(orgId) &&
            exists(/databases/$(database)/documents/organizations/$(orgId)/documents/$(documentId)) &&
            isValidChunk(incoming(), orgId, documentId) &&
            incoming().id == chunkId &&
            incoming().ownerId == get(/databases/$(database)/documents/organizations/$(orgId)).data.ownerId &&
            incoming().createdAt == request.time;
          allow update: if false;
          allow delete: if isValidId(orgId) && isValidId(documentId) && isValidId(chunkId) && (isOrgOwner(orgId) || isAdmin());
        }
      }

      match /analyses/{analysisId} {
        allow get: if isValidId(orgId) && isValidId(analysisId) && (isOrgMember(orgId) || isAdmin());
